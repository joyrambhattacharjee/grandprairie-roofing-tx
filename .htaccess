# GrandPrairieRoofingTX - Canonical enforcement (Apache / cPanel)
# Canonical host: https://grandprairieroofingtx.com (non-www, HTTPS)
# Canonical format:
#   Home:  https://grandprairieroofingtx.com/
#   Pages: https://grandprairieroofingtx.com/about (no .html, no trailing slash)
#   Example: https://grandprairieroofingtx.com/services/new-roof-installation

RewriteEngine On
RewriteBase /

# 1. Force HTTPS + non-www in one redirect (prevents http/www duplicates)
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://grandprairieroofingtx.com%{REQUEST_URI} [L,R=301,NE]

# 2. Redirect index.html -> / (prevents /index and /index.html duplicates)
RewriteRule ^index\.html$ / [R=301,L,NC]

# 3. Redirect /xxx.html -> /xxx (so .html version never indexes)
# Uses THE_REQUEST to avoid redirect loops with internal rewrites below
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# 4. Remove trailing slash for pages (enforce canonical WITHOUT slash)
# Homepage / is excluded automatically (it IS a directory).
# Real directories (e.g. /services/ folder listing) are excluded via !-d.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# 5. Internally serve clean URL from .html file (no redirect, user sees clean URL)
# /about -> /about.html, /services/new-roof-installation -> /services/new-roof-installation.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]
